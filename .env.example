# ===== 大模型 =====
# 兼容 OpenAI 接口的 API Key（默认对接硅基流动 https://api.siliconflow.cn）
LLM_API_KEY=your_api_key_here

# ===== MySQL =====
# 后端（OmegaConf）与 Docker Compose 共用同一组变量，改一处即可同时生效
DB_HOST=localhost
DB_PORT=3306
DB_USER=shopkeeper
DB_PASSWORD=change_me_local_only
MYSQL_ROOT_PASSWORD=change_me_root

# ===== 基础服务 =====
# 本地运行保持默认即可；容器化或远程部署时按实际情况修改
QDRANT_HOST=localhost
QDRANT_PORT=6333
ES_HOST=localhost
ES_PORT=9200
ES_INDEX_NAME=value_index
EMBEDDING_HOST=localhost
EMBEDDING_PORT=8081
